NVIDIA_NIM_API_KEY=nvapi-REPLACE-ME
NIM_MODEL=nvidia/nemotron-3-super-120b-a12b
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_TEMPERATURE=0.2
QDRANT_URL=https://<your-cluster-id>.cloud.qdrant.io:6333
QDRANT_API_KEY=<your-api-key>

# Neo4j knowledge graph (kb/neo4j_store.py) — Literature Support's
# trait->gene relationship write. For local/docker-compose use, the `neo4j`
# service below exposes bolt on 7687 with these defaults; point NEO4J_URI at
# a managed instance (e.g. AuraDB) in other environments.
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-in-real-envs

# A2A endpoint for the external Literature Agent (owned/deployed separately —
# see kb/sources/literature_agent_client.py). Its /execute contract is the
# same AgentRequest/AgentResult envelope every worker agent here speaks.
LITERATURE_AGENT_URL=http://literature-agent:8000/execute

# KEGG REST API (kb/sources/kegg_client.py) is free for academic,
# non-commercial use only (https://www.kegg.jp/kegg/legal.html). Leave both
# unset/false for academic use. If this deployment is commercial, set
# KEGG_COMMERCIAL_USE=true AND KEGG_COMMERCIAL_USE_LICENSED=true (the latter
# only once you actually hold a paid KEGG FTP/API license) — the Pathways
# agent will refuse to call KEGG otherwise.
KEGG_COMMERCIAL_USE=false
KEGG_COMMERCIAL_USE_LICENSED=false
