+# Lazy-loaded, same pattern as rag_evaluators._get_relevance_cross_encoder().
+# Loading eagerly at module import time meant *any* import of kb.retrieval /
+# kb.qdrant_store (including from offline unit tests that never call
+# embed_text, e.g. evaluation/tests/test_rag_evaluators_unit.py) required a
+# live connection to huggingface.co to download the model, and failed hard
+# with an OSError if that network call didn't succeed -- turning a pure
+# metric-logic test into a flaky network test, and in a sandboxed/restricted
+# CI runner turning it into a guaranteed collection error. Deferring the
+# download to first real use means only code paths that actually embed text
+# pay that cost or that risk.
+_model = None
+
+
+def _get_model() -> "SentenceTransformer":
+    global _model
+    if _model is None:
+        _model = SentenceTransformer("all-MiniLM-L6-v2")
+    return _model
+
 
