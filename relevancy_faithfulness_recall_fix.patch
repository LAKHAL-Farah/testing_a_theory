-        for k in ("go_name", "pathway_name", "function_summary", "title", "short_summary", "reasoning")
+        for k in (
+            "go_name", "pathway_name", "protein_name", "function_summary",
+            "title", "short_summary", "reasoning",
+        )
     ]
     return " ".join(p for p in parts if p)
 
